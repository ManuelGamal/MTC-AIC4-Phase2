ARG BASE_IMAGE=nvcr.io/nvidia/pytorch:25.06-py3-igpu
FROM ${BASE_IMAGE}
ARG SKIP_BUILD_VERIFY=0

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    CUDA_MODULE_LOADING=LAZY \
    OMP_NUM_THREADS=4 \
    ORIN_FP16=1 \
    ORIN_TF32=1 \
    ORIN_CUDA_AUTOTUNE=1 \
    ORIN_CHANNELS_LAST=1 \
    ORIN_CUDA_WARMUP=1 \
    ORIN_COMPILE=0 \
    ORIN_TENSORRT=1 \
    ORIN_TENSORRT_AUTOBUILD=0 \
    ORIN_TENSORRT_REQUIRED=0 \
    ORIN_TENSORRT_ENGINE=/opt/newbiesquad/checkpoints/uetrack_fp16.engine

RUN apt-get update && apt-get install -y --no-install-recommends \
        libgl1 \
        libglib2.0-0 \
        libgomp1 \
        ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/newbiesquad

COPY requirements.txt .
RUN python -m pip install --upgrade pip \
    && python -m pip install --only-binary=:all: -r requirements.txt

COPY . .
RUN if [ "${SKIP_BUILD_VERIFY}" != "1" ]; then python tools/verify_jetson_requirements.py; fi

CMD ["python", "inference.py", "test.json", "public_lb", "predictions.csv"]
